{
  "kind": "collectionType",
  "collectionName": "time_slots",
  "info": {
    "singularName": "time-slot",
    "pluralName": "time-slots",
    "displayName": "TimeSlot",
    "description": "Scheduled activity occurrences"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "startDate": {
      "type": "datetime",
      "required": true
    },
    "endDate": {
      "type": "datetime",
      "required": true
    },
    "location": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::location.location",
      "inversedBy": "timeSlots"
    },
    "scheduledActivities": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::scheduled-activity.scheduled-activity",
      "mappedBy": "timeSlot"
    },
    "participants": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::participant.participant",
      "inversedBy": "timeSlots"
    },
    "facilitators": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::facilitator.facilitator",
      "inversedBy": "timeSlots"
    },
    "roomSession": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::room-session.room-session",
      "inversedBy": "timeSlots"
    },
    "checkIns": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::check-in.check-in",
      "mappedBy": "timeSlot"
    }
  }
}
